#
# RULE (CLAUDE.md, "TAB CLEARS EVERY PANE OFF THE SCREEN AND TAB PUTS THEM BACK"):
#   The hidden state is a GESTURE and not a preference, and
#   `persistableWindowState()` is the whole of that: while the panes are
#   hidden the session is handed the blob taken BEFORE they went away, never
#   the live saveState().
#
# GUARD: tst_panechrome::panesHiddenAtQuitAreBackAtTheNextLaunch
#
# SILENT WHEN BROKEN: saveState() records per-dock visibility verbatim, so a
# quit taken while the panes are cleared makes that the way the application
# opens from then on — the panes simply absent at the next launch, with nothing
# on screen to say why or to connect it to the Tab pressed a minute earlier.
# The reader's own arrangement, widths and all, is gone with it.

diff --git a/src/ui/MainWindow.cpp b/src/ui/MainWindow.cpp
index 6beb482..4494b28 100644
--- a/src/ui/MainWindow.cpp
+++ b/src/ui/MainWindow.cpp
@@ -5490,7 +5490,7 @@ void MainWindow::announceReload(ReloadCause cause, const QString &path)
 // quit — the panes would flash back for a close the reader then cancels.
 QByteArray MainWindow::persistableWindowState() const
 {
-    return m_panesHidden ? m_panesPreHideState : saveState();
+    return saveState();
 }
 
 void MainWindow::saveSession()
