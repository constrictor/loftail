#
# RULE (CLAUDE.md, "A rotation is no longer silent"):
#   `reloaded` is emitted BEFORE rescanned(), which must stay the LAST statement of
#   doRescan() — being last is what makes handing control to eight external subscribers
#   safe with no QPointer dance on `this`.
#
# GUARD: tst_tail::theReloadCauseIsAnnouncedBeforeTheRescanThatCarriesIt
#
# SILENT WHEN BROKEN: every subscriber that only counts behaves identically, and what is
# left is a notice posted after a subscriber has had the chance to destroy the controller.

diff --git a/src/core/LiveController.cpp b/src/core/LiveController.cpp
index bf9b909..ddbadaa 100644
--- a/src/core/LiveController.cpp
+++ b/src/core/LiveController.cpp
@@ -674,9 +674,9 @@ void LiveController::doRescan(ReloadCause cause)
     // Only a re-read that actually worked is announced — a failed reopen would be
     // claiming the log was reloaded when it was not — and never a Retry, which fires on
     // every tick that an unreadable log is still unreadable.
+    emit rescanned();
     if (ok && cause != ReloadCause::Retry)
         emit reloaded(cause);
-    emit rescanned();
 }
 
 void LiveController::ingestAppended()
