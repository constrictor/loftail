# RULE (CLAUDE.md, "M21 ... AtomicJson"; SPEC.md §10):
#   AtomicJson::write() compares what QSaveFile::write() returned against what it
#   was given, and cancels the write when they differ. commit() does NOT catch a
#   short write: it renames the truncated temporary into place and reports
#   success
#
# GUARD: tst_writefailure::aWriteThatCannotBeFinishedIsReportedAndKeepsThePreviousContents
#
# SILENT WHEN BROKEN: the call returns true, so every caller — the settings pool, the
# host bookmarks, the session — believes it saved. What is on disk is a JSON
# document cut off in the middle, which the next launch reads as "no map" or "no
# record" and quietly rebuilds around.

diff --git a/src/core/AtomicJson.cpp b/src/core/AtomicJson.cpp
index f05628b..669519e 100644
--- a/src/core/AtomicJson.cpp
+++ b/src/core/AtomicJson.cpp
@@ -59,12 +59,7 @@ bool AtomicJson::write(const QString &path, const QJsonDocument &doc, QString *e
         return false;
     }
     const QByteArray bytes = doc.toJson(QJsonDocument::Indented);
-    if (file.write(bytes) != bytes.size()) {
-        if (error)
-            *error = file.errorString();
-        file.cancelWriting();
-        return false;
-    }
+    file.write(bytes);
     if (!file.commit()) {
         if (error)
             *error = file.errorString();
