# RULE (CLAUDE.md, "The write rules are in one place"):
#   what is about to be written is read back through the very detection the
#   editor's read runs, and a save that would not survive it is REFUSED —
#   nothing written, the file untouched, the buffer keeping every keystroke.
#   ConfigView::bytesToSave() is the ONE way in, so no save site can walk round
#   it by reaching toBytes() directly
#
# GUARD: tst_configeditor::aSaveThatWouldNotReadBackIsRefusedAndTheEditsStay
#
# SILENT WHEN BROKEN: the save reports success and the tab clears its modified
# mark, so the buffer is no longer treated as the only copy — while what is on
# disk is short of what was on screen by whatever the encoding could not spell.
# The next open shows the shortened file, which is by then the only version left.

diff --git a/src/ui/ConfigView.cpp b/src/ui/ConfigView.cpp
index 84d401a..2dbf3dd 100644
--- a/src/ui/ConfigView.cpp
+++ b/src/ui/ConfigView.cpp
@@ -281,8 +281,8 @@ bool ConfigView::bytesToSave(QByteArray *bytes, QString *error) const
     // the rule about what a config write may cost belongs.
     const QString text = saveText();
     QByteArray out = toBytes();
-    if (!configBytesReadBackAs(displayName(), out, text, error))
-        return false;
+    (void)text;
+    (void)error;
     if (bytes)
         *bytes = out;
     return true;
