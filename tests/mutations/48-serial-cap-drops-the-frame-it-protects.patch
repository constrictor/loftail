# RULE (CLAUDE.md, "THE FRAME IS LENGTH-DELIMITED FOR RAW AND SCANNED FOR
# BASE64"):
#   The buffer cap drops only what PRECEDES the begin marker, or it cuts off the
#   frame it exists to protect.
#
# GUARD: tst_serialframing::theCapNeverDropsAFrameThatHasAlreadyStarted
#
# SILENT WHEN BROKEN: every later read answers Incomplete and the command times
# out against a device that answered it correctly — reachable on a booting board,
# which prints megabytes while a command is in flight and is the case the cap
# exists for in the first place.

diff --git a/src/core/SerialFraming.cpp b/src/core/SerialFraming.cpp
index adcd275..e9c142b 100644
--- a/src/core/SerialFraming.cpp
+++ b/src/core/SerialFraming.cpp
@@ -181,14 +181,7 @@ void capFrameBuffer(QByteArray *buffer, const SerialFrame &frame)
     // started cuts the marker off, readFramedAnswer() then answers Incomplete for ever, and
     // the command times out on a device that answered it perfectly. Reachable on a booting
     // board, which prints megabytes while a command is in flight — the case this exists for.
-    const QByteArray begin = QByteArrayLiteral("LFB-") + frame.token;
-    const qsizetype markerAt = buffer->indexOf(begin);
-    if (markerAt > 0) {
-        buffer->remove(0, markerAt);
-        return;
-    }
-    if (markerAt == 0)
-        return;   // nothing before it to drop; the payload's own size is the caller's bound
+    Q_UNUSED(frame);
 
     // No frame in flight yet: the answer is always the newest, so the oldest noise goes.
     buffer->remove(0, buffer->size() - kFrameBufferCap);
