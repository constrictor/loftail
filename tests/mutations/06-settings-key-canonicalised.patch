# RULE (CLAUDE.md, "ONE LOG, ONE SPELLING, and the spelling is the name as OPENED"):
#   `logSettingsKey()` is `absoluteFilePath()` and never `canonicalFilePath()`:
#   a pattern is tested through `logMatchTarget()`, which resolves no symbolic
#   link, so a canonical key asks one question about a log and answers another.
#
# GUARD: tst_openflow::aSymlinkedLogIsStoredUnderTheNameItWasOpenedBy
#
# SILENT WHEN BROKEN: merely opening `latest.log` leaves a record behind under
# the target's name, shadowing the pattern for ever and burning a slot out of
# the pool of 500 every day on a daily rotation.

diff --git a/src/core/RemoteLocation.cpp b/src/core/RemoteLocation.cpp
index 4738fb3..40a0a88 100644
--- a/src/core/RemoteLocation.cpp
+++ b/src/core/RemoteLocation.cpp
@@ -341,7 +341,8 @@ QString logSettingsKey(const QString &path)
     // absoluteFilePath() cleans `.` and `..` and resolves nothing, so it is stable
     // against the working directory (which is what the key is for) without being stable
     // against the file's own identity (which it deliberately no longer claims).
-    return QFileInfo(path).absoluteFilePath();
+    const QString canonical = QFileInfo(path).canonicalFilePath();
+    return canonical.isEmpty() ? QFileInfo(path).absoluteFilePath() : canonical;
 }
 
 QString legacyLogSettingsKey(const QString &path)
