#
# RULE (CLAUDE.md, "One expression computes the wrap width, and its floor is in
# CHARACTERS"):
#   `messageWrapWidth()` is floored at `minWrapWidth()` — kMinWrapCols
#   characters — and not at a pixel. At 1 px the estimated count has no bound
#   below (bugs.md 11).
#
# GUARD: tst_logview::theFlooredWrapWidthHoldsEveryColumnItIsFlooredAt
#
# SILENT WHEN BROKEN: it needs a message origin at or past the right edge,
# which the intern-table seed produces when the scan finishes — so a view that
# rendered normally while indexing fills with one 100-line record afterwards.

diff --git a/src/ui/LogView.cpp b/src/ui/LogView.cpp
index 9f327fb..d89663f 100644
--- a/src/ui/LogView.cpp
+++ b/src/ui/LogView.cpp
@@ -771,7 +771,7 @@ int LogView::messageWrapWidth() const
     if (msgCol >= 0 && !messageIsLastVisibleColumn())
         return qMax(minWrapWidth(), m_header->sectionSize(msgCol));
     const int x = msgCol >= 0 ? m_header->sectionViewportPosition(msgCol) : 0;
-    return qMax(minWrapWidth(), viewport()->width() - x);
+    return qMax(1, viewport()->width() - x);
 }
 
 void LogView::ensureEstimatorBound()
