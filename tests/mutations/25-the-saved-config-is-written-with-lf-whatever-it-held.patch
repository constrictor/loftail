# RULE (CLAUDE.md, "The write rules are in one place"):
#   ConfigView replays the LINE ENDINGS it read. QPlainTextEdit works in
#   paragraphs, so the widget holds '\n' whatever the file held, and the ending
#   has to be remembered on the way in rather than re-read on the way out
#
# GUARD: tst_configeditor::aSavedConfigKeepsTheEncodingTheBomAndTheLineEndingsItWasReadWith
#
# SILENT WHEN BROKEN: the file is still correct and still parses; every line of it
# now differs from every line in version control, so the one line that was
# actually edited is invisible in the diff.

diff --git a/src/ui/ConfigView.cpp b/src/ui/ConfigView.cpp
index fb2aefb..b6d9362 100644
--- a/src/ui/ConfigView.cpp
+++ b/src/ui/ConfigView.cpp
@@ -259,8 +259,6 @@ QByteArray ConfigView::toBytes() const
     // QPlainTextEdit uses U+2029 for a paragraph break in some paths; normalise it
     // deliberately rather than letting it reach a config parser.
     text.replace(QChar(0x2029), QLatin1Char('\n'));
-    if (m_lineEnding != QLatin1String("\n"))
-        text.replace(QLatin1String("\n"), m_lineEnding);
 
     Decoder decoder = Decoder::detect(QByteArrayView(), static_cast<Encoding>(m_encoding));
     // The BOM is REPLAYED, never re-derived: only the read knew whether the file had
