# RULE (CLAUDE.md, "The write rules are in one place"):
#   ConfigView replays the ENCODING and the BOM it read — Decoder::encode() is
#   the reverse direction on the same class, and only the read knew whether the
#   file had a mark. A config file's encoding is not its log's
#
# GUARD: tst_configeditor::aSavedConfigKeepsTheEncodingTheBomAndTheLineEndingsItWasReadWith
#
# SILENT WHEN BROKEN: the editor shows exactly the same text before and after, and
# so does every other viewer that guesses UTF-8. What changed is the bytes a
# non-UTF-8 config parser reads, on a file loftail was only asked to edit one
# line of.

diff --git a/src/ui/ConfigView.cpp b/src/ui/ConfigView.cpp
index fb2aefb..75e705e 100644
--- a/src/ui/ConfigView.cpp
+++ b/src/ui/ConfigView.cpp
@@ -262,10 +262,10 @@ QByteArray ConfigView::toBytes() const
     if (m_lineEnding != QLatin1String("\n"))
         text.replace(QLatin1String("\n"), m_lineEnding);
 
-    Decoder decoder = Decoder::detect(QByteArrayView(), static_cast<Encoding>(m_encoding));
+    Decoder decoder = Decoder::detect(QByteArrayView(), Encoding::Utf8);
     // The BOM is REPLAYED, never re-derived: only the read knew whether the file had
     // one, and adding one unconditionally grows a mark onto a file that never had it.
-    return m_bom + decoder.encode(text);
+    return decoder.encode(text);
 }
 
 bool ConfigView::isModified() const
