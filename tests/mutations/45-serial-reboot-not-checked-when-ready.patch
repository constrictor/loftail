# RULE (CLAUDE.md, "A REBOOT IS A RECONNECT AND NOTHING MORE"):
#   The reboot pattern is asked on every feed in EVERY step, `Ready` included —
#   which is the only step a reboot actually happens in, so a machine that only
#   looked during the login would be a machine that never noticed one.
#
# GUARD: tst_serialloginmachine::theRebootRegexpFiresFromTheReadyStateToo
#
# SILENT WHEN BROKEN: a board that restarts under a tab is never noticed, so the
# tab keeps a session that no longer exists and every command afterwards fails
# for a reason that reads as a dropped line. Which is the one event the whole
# setting exists for.

diff --git a/src/core/SerialLoginMachine.cpp b/src/core/SerialLoginMachine.cpp
index 395ee7d..0c2c4e3 100644
--- a/src/core/SerialLoginMachine.cpp
+++ b/src/core/SerialLoginMachine.cpp
@@ -207,7 +207,8 @@ LoginAction SerialLoginMachine::feed(QByteArrayView arrived, qint64 nowMs)
     // OUTRANKS EVERYTHING ELSE IN THIS FEED. Ready is the step a reboot actually happens
     // in; a machine that only looked during the login would never notice one, which is
     // the whole of what SPEC.md §3 promises about a device that restarts.
-    if (m_step != LoginStep::Failed && windowMatches(m_rebootRe)) {
+    if (m_step != LoginStep::Failed && m_step != LoginStep::Ready
+        && windowMatches(m_rebootRe)) {
         m_sawReboot = true;
         m_window.clear();
         LoginAction a;
