#
# RULE (CLAUDE.md, "Four more M27 rules, and one of them is a bug found by
# reading"):
#   `LogProfile::operator==` gained a clause for `serialProfile`, or the setting
#   is silent DATA LOSS rather than a missing feature.
#
# GUARD: tst_logsettings::aProfileDiffersWhenAnyOneFieldOfItDoes
#
# SILENT WHEN BROKEN: `LogFileSettings::reduce()` deletes a per-log record that
# compares equal to what the log inherits, so a field the comparison does not
# look at is a field two profiles can NEVER differ in. The log's own entry is
# deleted on the next write and the setting is gone, with nothing on screen to
# say so.

diff --git a/src/core/LogProfile.h b/src/core/LogProfile.h
index d1cb070..8d33a57 100644
--- a/src/core/LogProfile.h
+++ b/src/core/LogProfile.h
@@ -109,7 +109,7 @@ struct LogProfile
     bool operator==(const LogProfile &o) const
     {
         return format == o.format && wrapMode == o.wrapMode && configPath == o.configPath
-            && restartScript == o.restartScript && serialProfile == o.serialProfile;
+            && restartScript == o.restartScript;
     }
     bool operator!=(const LogProfile &o) const { return !(*this == o); }
 };
