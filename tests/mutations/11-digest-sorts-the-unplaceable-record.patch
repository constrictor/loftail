#
# RULE (CLAUDE.md, "The digest strip is CAPTIONED and its rows are CHRONOLOGICAL"):
#   publishDigest() dedupes by ordinal and then reorders by timestamp, and a record with
#   NO timestamp keeps its SLOT and never reaches the comparator. Record::kNoTimestamp is
#   qint64's minimum, so sorting on it pins every unparsed line to the top of the strip.
#
# GUARD: tst_digest::anUnplaceableRecordInTheMiddleKeepsItsSlotRatherThanSortingToTheTop
#
# SILENT WHEN BROKEN: the strip holds the right rows in the wrong order, which reads as
# a bug in the log rather than in the viewer.
# tst_digest::aRecordWithNoTimestampKeepsItsSlot cannot see it: there the unplaceable
# record is the FIRST ordinal, so pinning it to the top and leaving it where it is
# produce the same list.

diff --git a/src/core/Document.cpp b/src/core/Document.cpp
index 00c2816..bf5cbe2 100644
--- a/src/core/Document.cpp
+++ b/src/core/Document.cpp
@@ -663,9 +663,7 @@ bool Document::publishDigest(bool force)
     // digest never uses the incremental append path (appendVisible/trailingCountFrom),
     // which is the one place an ascending list is assumed — every digest update
     // republishes wholesale through setVisible().
-    const auto placeable = [this](qint32 o) {
-        return m_index.records.at(o).timestamp != Record::kNoTimestamp;
-    };
+    const auto placeable = [](qint32) { return true; };
     QVector<qint32> chronological;
     chronological.reserve(ordinals.size());
     for (const qint32 o : ordinals)
