# RULE (CLAUDE.md, "Six more rules that are easy to undo by accident"):
#   The density scan's slice timer runs only while the bar is VISIBLE — "or ten open logs
#   are ten scans, nine of them for marks nobody can see". isVisible() is false for a
#   widget in a tab that is not current, which is exactly the case being guarded.
#
# GUARD: tst_densitybar::aHiddenBarScansNothingAndAVisibleOneConvergesWithoutRescanningARow
#
# SILENT WHEN BROKEN: every bar draws exactly what it drew before, because the scan is
# correct either way — it is being paid for on tabs nobody is looking at, which shows up
# as a slow window with ten logs open and as nothing at all with one.

diff --git a/src/ui/DensityScrollBar.cpp b/src/ui/DensityScrollBar.cpp
--- a/src/ui/DensityScrollBar.cpp
+++ b/src/ui/DensityScrollBar.cpp
@@ -185,8 +185,6 @@
     // Only while the bar is on screen. isVisible() is false for a widget in a tab that
     // is not current, which is exactly the case this is guarding: ten open logs must not
     // be ten scans.
-    if (!isVisible())
-        return;
     if (!m_scanTimer->isActive())
         m_scanTimer->start();
 }
