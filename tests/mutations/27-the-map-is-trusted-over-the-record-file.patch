# RULE (CLAUDE.md, "Ten M21 rules that are easy to undo by accident"):
#   Every record names its own address inside the slot file as well as in the
#   index, and read() CHECKS it — THE FILE WINS. That is the last line between a
#   stale map, which any interrupted write can leave, and one log opening with
#   another log's settings
#
# GUARD: tst_writefailure::everyInterruptionOfAWriteRecoversWithoutServingOneLogAnothersRecord
#
# SILENT WHEN BROKEN: only at an interruption point, and only for the log whose slot
# was reused. It then opens with a stranger's format, filters, highlight rules
# and run selection — a log that suddenly parses as nothing, with no gesture
# anywhere that explains it. tst_logfilestore::aSlotHoldingAnotherLogsRecordIsNot\
# Served fails under this patch too.

diff --git a/src/core/LogFileStore.cpp b/src/core/LogFileStore.cpp
index 43d106a..7da3a74 100644
--- a/src/core/LogFileStore.cpp
+++ b/src/core/LogFileStore.cpp
@@ -294,8 +294,7 @@ LogFileSettings LogFileStore::read(const QString &address)
         const LogFileSettings s = LogFileSettings::fromJson(doc.object());
         // THE FILE WINS. A map entry whose slot holds another log's record is a map that
         // is out of date, not a record that belongs to this address — see the header.
-        if (s.address == empty.address)
-            return s;
+        return s;
     }
 
     m_entries.remove(i);
