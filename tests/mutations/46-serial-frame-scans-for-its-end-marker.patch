#
# RULE (CLAUDE.md, "THE FRAME IS LENGTH-DELIMITED FOR RAW AND SCANNED FOR
# BASE64, AND THE TWO ARE NOT INTERCHANGEABLE"):
#   A RAW payload is bounded by the byte count `| head -c L` guarantees and is
#   never found by scanning, because a log is arbitrary bytes and may contain
#   this run's own token.
#
# GUARD: tst_serialframing::aPayloadHoldingTheTokenIsNotTruncatedByIt
#
# SILENT WHEN BROKEN: a log that happens to mention the token TRUNCATES ITSELF
# at that point and every record after it is absent — on exactly the logs nobody
# thinks to test, with nothing anywhere reporting a short read.

diff --git a/src/core/SerialFraming.cpp b/src/core/SerialFraming.cpp
index adcd275..9c4fdeb 100644
--- a/src/core/SerialFraming.cpp
+++ b/src/core/SerialFraming.cpp
@@ -92,7 +92,7 @@ FramedAnswer readFramedAnswer(const QByteArray &buffer, const SerialFrame &frame
 
     qsizetype payloadEnd = -1;
     qsizetype searchFrom = payloadStart;
-    if (frame.expected >= 0) {
+    if (false) {
         // LENGTH-DELIMITED. The payload may be arbitrary bytes — a log — so it may contain
         // this very token, and scanning it would truncate the log at that point.
         if (buffer.size() - payloadStart < frame.expected) {
