# RULE (CLAUDE.md, "The view's line pitch must be the number QT LAYS TEXT OUT AT"):
#   `lineHeight()` is `qCeil(QFontMetricsF(...).height())`, never
#   `QFontMetrics::height()`, which rounds ascent and descent separately and so
#   comes out a pixel short at 15 of the 27 point sizes the zoom offers.
#
# GUARD: tst_logview::everyWrappedLineOfARecordIsDrawnInsideTheRowItWasGiven
#
# SILENT WHEN BROKEN: one pixel of every wrapped line is clipped and past about
# thirteen lines the last line is not drawn at all — with no ellipsis and no
# tooltip, because a wrapped message deliberately offers neither.

diff --git a/src/ui/LogView.cpp b/src/ui/LogView.cpp
index 9f327fb..2b23ce3 100644
--- a/src/ui/LogView.cpp
+++ b/src/ui/LogView.cpp
@@ -586,7 +586,7 @@ LogView::~LogView() = default;
 // entirely. qCeil(QFontMetricsF::height()) is that number at every size measured.
 int LogView::lineHeight() const
 {
-    return qMax(1, qCeil(QFontMetricsF(fontMetrics()).height()));
+    return qMax(1, fontMetrics().height());
 }
 int LogView::visibleLines() const { return qMax(1, viewport()->height() / lineHeight()); }
 // Both go through the MODEL, not the document (M19, ARCHITECTURE.md §7.5): which
