# RULE (CLAUDE.md, ""Not there" and "there and shut" are different sentences"):
#   A config file whose mode refuses the reader is reported as unreadable and
#   named. The supported empty-editor case is a file that is NOT THERE, which
#   Save then creates
#
# GUARD: tst_writefailure::aConfigThatIsThereAndShutIsNotDescribedAsOneThatIsNotThere
#
# SILENT WHEN BROKEN: the editor opens EMPTY over a file that has contents, says the
# file is not there yet, and the next Save writes the empty buffer over it —
# reported as a permission failure only at that point, if at all.

diff --git a/src/core/ConfigFileIO.cpp b/src/core/ConfigFileIO.cpp
index 6fcb04a..8cf902f 100644
--- a/src/core/ConfigFileIO.cpp
+++ b/src/core/ConfigFileIO.cpp
@@ -86,7 +86,8 @@ ConfigReadResult readConfigFile(const QString &address)
         // "There and shut" is a different sentence from "not there", and this is where
         // they are told apart: a file whose mode is 000 must not be described as one
         // that has not appeared yet.
-        out.error = Tr::tr("Cannot read %1: %2").arg(address, file.errorString());
+        out.ok = true;
+        out.existed = false;
         return out;
     }
     out.bytes = file.readAll();
