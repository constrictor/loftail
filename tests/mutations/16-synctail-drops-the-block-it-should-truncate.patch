#
# RULE (CLAUDE.md, "A measured block is measured only up to a RECORD COUNT"):
#   syncTail() truncates the trailing block's cache back to the OLD trailing record —
#   the first that can have moved (invariant #9) — rather than dropping the block:
#   "drop the block instead and a tailed log re-decodes 4096 messages on every paint".
#
# GUARD: tst_estimatedgeometry::anAppendReMeasuresOnlyTheRecordsTheGrowthCouldHaveTouched
#
# SILENT WHEN BROKEN: nothing on screen changes at all. The block is simply re-measured
# from its first record on the next paint, so every height is right, the scrollbar is
# right, and the only difference is 4096 message decodes per ingest tick of every live
# log — which no assertion about geometry can see.

diff --git a/src/core/EstimatedGeometry.cpp b/src/core/EstimatedGeometry.cpp
--- a/src/core/EstimatedGeometry.cpp
+++ b/src/core/EstimatedGeometry.cpp
@@ -286,7 +286,7 @@
         m_blockPhysical[b] = m_idx->firstLineOfRecord(end) - m_idx->firstLineOfRecord(start);
     }
 
-    truncateBlockMeasurement(firstBlock, firstDirty - firstBlock * RecordIndex::kBlockSize);
+    truncateBlockMeasurement(firstBlock, 0);
     refreshTotals();
     return true;
 }
