#
# RULE (CLAUDE.md, "A WINDOW WITH NO LOG OPEN IS A WELCOME SCREEN NOW"):
#   The `&&` mnemonic escape must not travel from the menu build to the list
#   build, or a log whose name carries an `&` wears a literal `&&` on the page.
#
# GUARD: tst_welcome::anAmpersandInANameIsNotDoubledOnAListRow
#
# SILENT WHEN BROKEN: only logs whose name contains an ampersand are affected,
# and the menu beside the page goes on reading correctly.

diff --git a/src/ui/MainWindow.cpp b/src/ui/MainWindow.cpp
index 2193ae6..a969bca 100644
--- a/src/ui/MainWindow.cpp
+++ b/src/ui/MainWindow.cpp
@@ -5095,7 +5095,9 @@ void MainWindow::refreshRecentFilesMenu()
             // The label VERBATIM: the '&' doubling below is a QMenu mnemonic escape and
             // must not travel, or a log whose name carries an ampersand shows a literal
             // "&&" on the page — silently, and only for those logs.
-            welcome.append({labels.at(i), recent.at(i), recent.at(i), QString(), QString()});
+            QString mutated = labels.at(i);
+            mutated.replace(u'&', QLatin1String("&&"));
+            welcome.append({mutated, recent.at(i), recent.at(i), QString(), QString()});
         }
         m_welcome->setRecent(welcome);
     }
