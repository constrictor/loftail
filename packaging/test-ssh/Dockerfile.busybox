# The other userland. Alpine's `ls`, `wc` and `head` are busybox applets, not coreutils,
# and ExecSizeProbe's rungs are parsed out of their OUTPUT — which is the one thing about
# the exec transport that varies by machine and the one thing no fake can vary
# (ARCHITECTURE.md §6.3.1). Run with LOFTAIL_WITH_STAT=no it is the stripped-down image
# the ladder below `stat` was written for, and it keeps its sftp-server so that
# theExecFallbackSizesWithoutStat() still has an SFTP size to check the rungs against.
FROM alpine:3.20

# The `sed` on /etc/shadow unlocks the key-only account; see Dockerfile.ubuntu.
RUN apk add --no-cache openssh-server openssh-keygen openssh-sftp-server \
    && adduser -D -s /bin/sh loftail \
    && sed -i 's/^loftail:[^:]*:/loftail:*:/' /etc/shadow \
    && mkdir -p /run/sshd /var/empty

COPY entrypoint.sh /usr/local/bin/loftail-sshd-entrypoint
RUN chmod +x /usr/local/bin/loftail-sshd-entrypoint

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/loftail-sshd-entrypoint"]
