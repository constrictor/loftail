<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Info.plist template for the macOS .app bundle. CMake substitutes the
  MACOSX_BUNDLE_* @VARS@ from src/CMakeLists.txt at configure time.

  CFBundleDocumentTypes below is a SOFT (capability) association only, the macOS
  analog of the Linux .desktop MimeType= key: LSHandlerRank=Alternate makes loftail
  offer itself in Finder's "Open With" for .log files WITHOUT claiming the default
  handler. Role=Viewer matches "strictly a reader" (SPEC.md — loftail never edits).
  Claiming the default stays a user/installer decision (PLAN.md M7); the app never
  does it. Scoped to the "log" extension so loftail does not volunteer for every
  plain-text file. (A precise imported-UTI declaration can replace the extension
  match when the macOS bundle is actually exercised — it is unverified today.)
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>loftail</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundleIconFile</key>
    <string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHumanReadableCopyright</key>
    <string>${MACOSX_BUNDLE_COPYRIGHT}</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Log File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>log</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
        </dict>
    </array>
</dict>
</plist>
