[Desktop Entry]
Type=Application
Name=loftail
GenericName=Log Viewer
Comment=Desktop viewer for log4cplus logs — filters and follows live logs
# %F, not %f: loftail takes several files on one command line and opens each in its
# own tab, so a multiple selection handed to it from a file manager becomes one window
# with N tabs. %f would launch a separate copy per file.
Exec=loftail %F
Icon=loftail
Terminal=false
Categories=Development;Utility;TextTools;
Keywords=log;log4cplus;tail;viewer;debug;
# Soft (capability) file association only. Declaring MimeType makes loftail appear
# in the file manager's "Open With" list for .log files — it does NOT make loftail
# the default handler. Becoming the default is a separate, explicit action
# (`xdg-mime default loftail.desktop text/x-log`, or the user choosing "always open
# with"), which the application never performs on its own — per PLAN.md M7 that
# stays an installer/packager/user decision.
#   - text/x-log is the freedesktop shared-mime-info type that *.log resolves to
#     (a subclass of text/plain). Scoped to it, NOT text/plain, so loftail does not
#     volunteer for every text file.
#   - This entry only takes effect once XDG desktop integration installs the
#     .desktop file (appimaged / AppImageLauncher / a distro package, which also
#     rewrites Exec= to the AppImage's real path). A bare AppImage run from
#     ~/Downloads registers nothing on its own.
MimeType=text/x-log;
StartupWMClass=loftail
